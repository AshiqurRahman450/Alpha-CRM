# ==================================================
# ALPHA ELEVATORS CRM — ENVIRONMENT CONFIGURATION
# ==================================================

# Server & Database
PORT=5000
NODE_ENV=development
MONGODB_URI=mongodb://localhost:27017/alpha_crm
JWT_SECRET=your_jwt_super_secret_key_change_in_production
JWT_EXPIRES_IN=7d

# Official Meta WhatsApp Business Platform / Cloud API
META_ACCESS_TOKEN=your_meta_system_user_access_token_here
META_PHONE_NUMBER_ID=your_whatsapp_phone_number_id_here
META_WABA_ID=your_whatsapp_business_account_id_here
META_APP_ID=your_meta_app_id_here
META_APP_SECRET=your_meta_app_secret_here
META_VERIFY_TOKEN=alpha_elevators_webhook_token_secure_99
META_API_VERSION=v20.0

# Frontend & Application URL
FRONTEND_URL=http://localhost:3000
NEXT_PUBLIC_API_URL=http://localhost:5000

# Automation Scheduler Settings
DEFAULT_UPDATE_FREQUENCY=20
DEFAULT_UPDATE_TIME=09:00
TIMEZONE=Asia/Kolkata
